# =============================================================================
# Missed. (What Did I Miss?) — Environment Configuration Template
# Copy this file to `.env` for local development. Never commit real `.env` files.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server Runtime & Security Configuration (server/ only — NEVER expose to client)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Storage mode:
# - "supabase": Uses Supabase Auth + Supabase PostgreSQL with Row-Level Security (required in production)
# - "memory":   Uses isolated in-memory Auth + Repository adapter (allowed ONLY in test / local offline dev)
STORAGE_MODE=supabase

# Supabase Project Credentials (Server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# SECURITY WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses RLS and is used strictly on the
# server for verified administrative account deletion (`DELETE /api/auth/account`).
# NEVER prefix this key with `VITE_` or expose it to browser/extension bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Rate Limiting (Sliding window in milliseconds and max requests per window)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_IMPORT_MAX=20
RATE_LIMIT_IMPORT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# 2. Frontend Public Configuration (frontend/ — exposed via Vite `VITE_*` prefix)
# -----------------------------------------------------------------------------
# Only public, non-secret values may use the `VITE_` prefix.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key